package web

import (
	"fmt"

	"github.com/JackWithOneEye/conwaymore/internal/games"
)

templ Lobby(gameList []games.Info, defaultWorldSize uint, formName string, formWorldSize uint, formError string) {
<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Conway's Game of Life — Lobby</title>
  <script>
    (() => {
      let theme;
      try {
        theme = JSON.parse(localStorage.getItem('conwaymore-prefs') || '{}').theme;
      } catch {}
      document.documentElement.dataset.theme =
        theme || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    })();
  </script>
  <link rel="preload" href="/assets/fonts/silkscreen-400.woff2" as="font" type="font/woff2" crossorigin />
  <link href="/assets/css/output.css" rel="stylesheet" />
  <script src="/assets/js/vendor.js"></script>
</head>

<body class="min-h-dvh overflow-y-auto p-4 sm:p-8">
  <div class="mx-auto flex max-w-3xl flex-col gap-6">
    <header class="hud flex flex-wrap items-center justify-between gap-3 px-4 py-3">
      <div class="flex items-center gap-3">
        <svg class="size-5 text-(--accent)" viewBox="0 0 3 3" shape-rendering="crispEdges" aria-hidden="true">
          <path fill="currentColor" d="M1 0h1v1H1zM2 1h1v1H2zM0 2h3v1H0z"></path>
        </svg>
        <div>
          <h1 class="text-sm sm:text-base leading-none">Conway's Game of Life</h1>
          <p class="mt-1 text-(--muted)">Multi-game lobby</p>
        </div>
      </div>
      <button id="theme-toggle" class="px-text-btn" aria-label="Toggle dark mode">
        <span class="theme-opt" data-opt="light">Light</span>/<span class="theme-opt" data-opt="dark">Dark</span>
      </button>
    </header>

    <section class="hud p-4 sm:p-5">
      <p class="hud-label mb-4"><span>01 /</span> Create game</p>
      <form id="create-game-form" method="POST" action="/games" class="flex flex-col gap-4">
        <div class="flex flex-col gap-1.5">
          <label for="game-name" class="text-(--muted)">Game name</label>
          <input
            id="game-name"
            name="name"
            type="text"
            required
            maxlength="64"
            value={ formName }
            placeholder="e.g. Glider Arena"
            autocomplete="off"
            class="px-input"
          />
        </div>

        <fieldset class="flex flex-col gap-2">
          <legend class="text-(--muted) mb-1.5">World size</legend>
          <div class="flex flex-wrap gap-2">
            for _, ws := range games.ValidWorldSizes {
              <label class="px-radio-chip">
                <input
                  type="radio"
                  name="worldSize"
                  value={ fmt.Sprintf("%d", ws) }
                  checked?={ selectedWorldSize(formWorldSize, defaultWorldSize) == ws }
                />
                <span>{ fmt.Sprintf("%d×%d", ws, ws) }</span>
              </label>
            }
          </div>
        </fieldset>

        if formError != "" {
          <p id="create-game-error" role="alert" class="border border-(--accent) px-3 py-2 text-(--accent)">
            { formError }
          </p>
        }

        <div class="flex items-center justify-end">
          <button id="create-game-submit" type="submit" class="px-text-btn" data-primary>
            Create &amp; Open
          </button>
        </div>
      </form>
    </section>

    <section class="hud p-4 sm:p-5">
      <div class="mb-4 flex items-center justify-between gap-2">
        <p class="hud-label"><span>02 /</span> Games ({ fmt.Sprintf("%d", len(gameList)) })</p>
        <button
          id="refresh-games"
          type="button"
          class="px-text-btn"
          hx-get="/games/list"
          hx-target="#game-list"
          hx-swap="outerHTML"
        >
          Refresh
        </button>
      </div>
      @GameList(gameList)
    </section>
  </div>

  <div id="error-banner"
    class="fixed top-0 left-0 right-0 bg-(--accent) text-(--accent-ink) p-2 z-50 transform -translate-y-full transition-transform">
  </div>

  <script>
    (() => {
      const toggle = document.getElementById('theme-toggle');
      const applyTheme = (theme) => {
        document.documentElement.dataset.theme = theme;
        toggle?.setAttribute('aria-pressed', String(theme === 'dark'));
      };
      applyTheme(document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light');
      toggle?.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        applyTheme(next);
        try {
          const prefs = JSON.parse(localStorage.getItem('conwaymore-prefs') || '{}');
          prefs.theme = next;
          localStorage.setItem('conwaymore-prefs', JSON.stringify(prefs));
        } catch {}
      });

      const showBanner = (msg) => {
        const el = document.getElementById('error-banner');
        if (!el) return;
        el.textContent = msg;
        el.classList.remove('-translate-y-full');
        setTimeout(() => el.classList.add('-translate-y-full'), 4000);
      };

      document.addEventListener('click', async (e) => {
        const target = e.target instanceof Element ? e.target.closest('[data-action]') : null;
        if (!target) return;

        const action = target.getAttribute('data-action');
        const id = target.getAttribute('data-game-id');
        if (!id) return;

        if (action === 'rename') {
          const current = target.getAttribute('data-game-name') || '';
          const next = window.prompt('Rename game:', current);
          if (next === null || next.trim() === '' || next.trim() === current) return;
          const res = await fetch(`/api/games/${id}`, {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ name: next.trim() }),
          });
          if (!res.ok) {
            const body = await res.json().catch(() => ({}));
            showBanner(body.error || 'Rename failed');
            return;
          }
          document.getElementById('refresh-games')?.click();
        } else if (action === 'delete') {
          const name = target.getAttribute('data-game-name') || `#${id}`;
          const viewers = Number(target.getAttribute('data-viewers') || '0');
          const msg = viewers > 0
            ? `Delete "${name}"? ${viewers} active viewer(s) will be disconnected.`
            : `Delete "${name}"?`;
          if (!window.confirm(msg)) return;
          const res = await fetch(`/api/games/${id}`, { method: 'DELETE' });
          if (!res.ok) {
            const body = await res.json().catch(() => ({}));
            showBanner(body.error || 'Delete failed');
            return;
          }
          document.getElementById('refresh-games')?.click();
        }
      });
    })();
  </script>
</body>

</html>
}

templ GameList(gameList []games.Info) {
  <div id="game-list" class="flex flex-col gap-2">
    if len(gameList) == 0 {
      <p class="border border-dashed border-(--muted) px-4 py-6 text-center text-(--muted)">
        No games yet. Create one above to start.
      </p>
    } else {
      for _, g := range gameList {
        <article class="game-row" data-game-id={ fmt.Sprintf("%d", g.ID) }>
          <div class="flex min-w-0 flex-1 flex-col gap-1">
            <div class="flex items-center gap-2">
              <span class="text-(--muted)">#{ fmt.Sprintf("%d", g.ID) }</span>
              <a href={ templ.SafeURL(fmt.Sprintf("/games/%d", g.ID)) } class="truncate text-xs hover:text-(--accent)">
                { g.Name }
              </a>
            </div>
            <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-(--muted)">
              <span>{ fmt.Sprintf("%d×%d", g.WorldSize, g.WorldSize) }</span>
              <span>{ gameStateLabel(g) }</span>
              <span>{ fmt.Sprintf("%d ms", g.Speed) }</span>
              <span>{ viewerLabel(g.Viewers) }</span>
            </div>
          </div>
          <div class="flex shrink-0 items-center gap-2">
            <a href={ templ.SafeURL(fmt.Sprintf("/games/%d", g.ID)) } class="px-text-btn" data-primary>
              Open
            </a>
            <button
              type="button"
              class="px-text-btn"
              data-action="rename"
              data-game-id={ fmt.Sprintf("%d", g.ID) }
              data-game-name={ g.Name }
            >
              Rename
            </button>
            <button
              type="button"
              class="px-text-btn"
              data-action="delete"
              data-game-id={ fmt.Sprintf("%d", g.ID) }
              data-game-name={ g.Name }
              data-viewers={ fmt.Sprintf("%d", g.Viewers) }
            >
              Delete
            </button>
          </div>
        </article>
      }
    }
  </div>
}

templ GameNotFound(message string) {
<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Game not found — Conway's Game of Life</title>
  <script>
    (() => {
      let theme;
      try {
        theme = JSON.parse(localStorage.getItem('conwaymore-prefs') || '{}').theme;
      } catch {}
      document.documentElement.dataset.theme =
        theme || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    })();
  </script>
  <link rel="preload" href="/assets/fonts/silkscreen-400.woff2" as="font" type="font/woff2" crossorigin />
  <link href="/assets/css/output.css" rel="stylesheet" />
</head>

<body class="flex min-h-dvh items-center justify-center p-6">
  <section class="hud flex max-w-md flex-col items-start gap-4 p-6">
    <p class="hud-label"><span>404 /</span> Not found</p>
    <p class="text-xs">{ message }</p>
    <a href="/" class="px-text-btn" data-primary>Back to Lobby</a>
  </section>
</body>

</html>
}

func selectedWorldSize(formWS, defaultWS uint) uint {
	if games.IsValidWorldSize(formWS) {
		return formWS
	}
	if games.IsValidWorldSize(defaultWS) {
		return defaultWS
	}
	return 1024
}

func gameStateLabel(g games.Info) string {
	if !g.Loaded {
		if g.Playing {
			return "Idle (will resume)"
		}
		return "Idle"
	}
	if g.Playing {
		return "Playing"
	}
	return "Paused"
}

func viewerLabel(n int) string {
	if n == 1 {
		return "1 viewer"
	}
	return fmt.Sprintf("%d viewers", n)
}
